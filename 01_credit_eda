//Feature Engineering
//Debt-to-Income Ratio
df["debt_to_income"] = (
    df["monthly_emi"] / df["income"]
)
//Loan-to-Income Ratio
df["loan_to_income"] = (
    df["loan_amount"] / df["income"]
)
//Balance-to-Income Ration
df["balance_to_income"] = (
    df["account_balance"] / df["income"]
)
//Deliquency Flag
df["has_delinquency"] = (
    df["delinquency_count"] > 0
).astype(int)

//Prepare Features and Target

X = df.drop(
    columns=[
        "customer_id",
        "default"
    ]
)

y = df["default"]

//One-hot Encoding
categorical_features = [
    "employment_type"
]

preprocessor = ColumnTransformer(
    transformers=[
        (
            "categorical",
            OneHotEncoder(handle_unknown="ignore"),
            categorical_features
        )
    ],
    remainder="passthrough"
)
//Train-Test Split
from sklearn.model_selection import train_test_split

X_train, X_test, y_train, y_test = train_test_split(
    X,
    y,
    test_size=0.20,
    random_state=42,
    stratify=y
)
