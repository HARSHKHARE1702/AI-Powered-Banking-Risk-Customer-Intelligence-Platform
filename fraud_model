import torch
from torch.utils.data import Dataset
from torch.utils.data import Dataloader
import torch.nn as nn


class FraudDataset(Dataset):

    def __init__(self, X, y):
        self.X = torch.tensor(
            X,
            dtype=torch.float32
        )

        self.y = torch.tensor(
            y,
            dtype=torch.float32
        )

    def __len__(self):
        return len(self.X)

    def __getitem__(self, index):
        return self.X[index], self.y[index]

train_dataset = FraudDataset(
    X_train_scaled,
    y_train.values
)

val_dataset = FraudDataset(
    X_val_scaled,
    y_val.values
)

test_dataset = FraudDataset(
    X_test_scaled,
    y_test.values
)

train_loader = DataLoader(
    train_dataset,
    batch_size=256,
    shuffle=True
)

val_loader = DataLoader(
    val_dataset,
    batch_size=256,
    shuffle=False
)

test_loader = DataLoader(
    test_dataset,
    batch_size=256,
    shuffle=False
)

class FraudNeuralNetwork(nn.Module):

    def __init__(self, input_dim):

        super().__init__()

        self.network = nn.Sequential(

            nn.Linear(input_dim, 128),

            nn.ReLU(),

            nn.BatchNorm1d(128),

            nn.Dropout(0.30),

            nn.Linear(128, 64),

            nn.ReLU(),

            nn.BatchNorm1d(64),

            nn.Dropout(0.30),

            nn.Linear(64, 1)
        )

    def forward(self, x):

        return self.network(x)

//class imbalance
input_dim = X_train_scaled.shape[1]

model = FraudNeuralNetwork(
    input_dim
)
fraud_count = y_train.sum()
legitimate_count = len(y_train) - fraud_count

pos_weight = torch.tensor(
    [legitimate_count / fraud_count],
    dtype=torch.float32
)
criterion = nn.BCEWithLogitsLoss(
    pos_weight=pos_weight
)
//Used adam as optimizer
optimizer = torch.optim.Adam(
    model.parameters(),
    lr=0.001
)
//Training loop
epochs = 30

for epoch in range(epochs):

    model.train()

    total_loss = 0

    for X_batch, y_batch in train_loader:

        optimizer.zero_grad()

        outputs = model(X_batch)
//Forward-pass
        loss = criterion(
            outputs.squeeze(),
            y_batch
        )
//Calculate-error
        loss.backward()
//Calcuate-gradients
        optimizer.step()
//Update-Model weights
        total_loss += loss.item()

    average_loss = (
        total_loss /
        len(train_loader)
    )

    print(
        f"Epoch {epoch + 1}/{epochs}, "
        f"Loss: {average_loss:.4f}"
    )
