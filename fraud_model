class FraudNeuralNetwork(nn.Module):

    def __init__(self, input_dim):

        super().__init__()

        self.network = nn.Sequential(

            nn.Linear(input_dim, 128),

            nn.ReLU(),

            nn.BatchNorm1d(128),

            nn.Dropout(0.30),

            nn.Linear(128, 64),

            nn.ReLU(),

            nn.BatchNorm1d(64),

            nn.Dropout(0.30),

            nn.Linear(64, 1)
        )

    def forward(self, x):

        return self.network(x)

